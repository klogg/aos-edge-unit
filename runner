set -Eeuo pipefail
shopt -s nullglob

LIBEXEC_DIR="$(dirname "$(realpath "$0")")"
readonly LIBEXEC_DIR
readonly LOG_TAG="aos-unit:runner"
. "${LIBEXEC_DIR}/log-helper"

: "${RUNTIME_DIRECTORY:?RUNTIME_DIRECTORY is undefined. Check systemd unit.}"
: "${STATE_DIRECTORY:?STATE_DIRECTORY is undefined. Check systemd unit.}"
: "${LOGS_DIRECTORY:?LOGS_DIRECTORY is undefined. Check systemd unit.}"
: "${CONFIGURATION_DIRECTORY:?CONFIGURATION_DIRECTORY is undefined. Check systemd unit.}"
: "${NETWORK_CONFIG:?NETWORK_CONFIG is undefined. Check systemd unit.}"

: "${BRIDGE_NAME:?BRIDGE_NAME missing in $NETWORK_CONFIG}"
: "${BRIDGE_IP:?BRIDGE_IP missing in $NETWORK_CONFIG}"
: "${NETMASK:?NETMASK missing in $NETWORK_CONFIG}"

readonly MAC_PREFIX="52:54:00"
readonly IMAGE_PREFIX="aos-vm-"

readonly DEFAULT_CONFIG_PATH="${CONFIGURATION_DIRECTORY}/unit_config.yaml"
readonly AWK_PARSER="${LIBEXEC_DIR}/config-parser"
readonly DEFAULT_IMGS_PATH="${STATE_DIRECTORY}"

readonly DEFAULT_MACHINE_TYPE_AMD64="q35"
readonly DEFAULT_MACHINE_TYPE_ARM64="virt"
readonly DEFAULT_CPU_TYPE_AMD64="max"
readonly DEFAULT_CPU_TYPE_ARM64="cortex-a57"

readonly QEMU_DEBUG_OPTIONS="guest_errors,nochain"

readonly OVMF_CODE_X86="/usr/share/OVMF/OVMF_CODE_4M.fd"
readonly OVMF_VARS_X86="/usr/share/OVMF/OVMF_VARS_4M.fd"
readonly OVMF_CODE_ARM="/usr/share/AAVMF/AAVMF_CODE.fd"
readonly OVMF_VARS_ARM="/usr/share/AAVMF/AAVMF_VARS.fd"

readonly DISK_FORMAT="qcow2"

# Globals set during initialisation and argument parsing
HOST_ARCH=""
CONFIG_FILE=""
IMAGE_DIR=""
declare -a NODE_SPECS=()

# Global populated by prepare_nodes(), consumed by launch_all_vms()
declare -a NODES_TO_START=()

detect_host_arch() {
    case "$(uname -m)" in
        x86_64)
            echo "x86_64"
            ;;
        aarch64)
            echo "aarch64"
            ;;
        *)
            die "$EXIT_CONFIG_ERROR" "Unsupported host architecture: $(uname -m)"
            ;;
    esac
}

check_kvm_available() {
    local vm_arch="$1"

    if [[ ! -e /dev/kvm ]]; then
        return 1
    fi
    if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
        return 1
    fi
    if [[ $vm_arch != "$HOST_ARCH" ]]; then
        return 1
    fi
    return 0
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config)
                [[ -n ${2:-} ]] || die "$EXIT_CONFIG_ERROR" "--config requires an argument"
                CONFIG_FILE="$2"
                shift 2
                ;;
            --images)
                [[ -n ${2:-} ]] || die "$EXIT_CONFIG_ERROR" "--images requires an argument"
                IMAGE_DIR="$2"
                shift 2
                ;;
            -h | --help)
                cat <<EOF
Usage: $0 [OPTIONS]

Options:
    --config PATH     Configuration file (default: ${DEFAULT_CONFIG_PATH})
    --images PATH     Images directory (default: ${DEFAULT_IMGS_PATH})
    -h, --help        Show this help
EOF
                exit 0
                ;;
            -*)
                die "$EXIT_CONFIG_ERROR" "Unknown option: $1"
                ;;
            *)
                die "$EXIT_CONFIG_ERROR" "Unexpected argument: $1 (direct mode has been removed; use --config ${DEFAULT_CONFIG_PATH})"
                ;;
        esac
    done

    if [[ -z $CONFIG_FILE ]]; then
        log "No config file specified, using default: $DEFAULT_CONFIG_PATH"
        CONFIG_FILE="$DEFAULT_CONFIG_PATH"
    fi

    if [[ -z $IMAGE_DIR ]]; then
        IMAGE_DIR="$DEFAULT_IMGS_PATH"
    fi
}

parse_config_file() {
    local config_file="$1"
    local images_path="$2"

    log "Reading configuration from $config_file..."

    if [[ ! -f $AWK_PARSER ]]; then
        die "$EXIT_CONFIG_ERROR" "Config parser not found: $AWK_PARSER"
    fi
    if [[ ! -f $config_file ]]; then
        die "$EXIT_CONFIG_ERROR" "Configuration file not found: $config_file"
    fi

    local parse_output
    if ! parse_output="$(awk -f "$AWK_PARSER" "$config_file" 2>&1)"; then
        error_multi <<<"$parse_output"
        die "$EXIT_CONFIG_ERROR" "Failed to parse YAML configuration"
    fi

    local node_args=""

    while IFS='=' read -r key value; do
        key="${key//[[:space:]]/}"
        value="${value%\"}"
        value="${value#\"}"

        case "$key" in
            NODE_ARGS)
                node_args="$value"
                ;;
            "") ;;
            *)
                die "$EXIT_CONFIG_ERROR" "Unexpected parser output key: $key"
                ;;
        esac
    done <<<"$parse_output"

    if [[ -z $node_args ]]; then
        die "$EXIT_CONFIG_ERROR" "No nodes found in configuration"
    fi

    IMAGE_DIR="$images_path"

    read -ra NODE_SPECS <<<"$node_args" || true
}

validate_config() {
    if [[ -z $IMAGE_DIR ]]; then
        die "$EXIT_CONFIG_ERROR" "Image directory not specified (use --images)"
    fi
    if [[ ! -d $IMAGE_DIR ]]; then
        die "$EXIT_CONFIG_ERROR" "Image directory does not exist: $IMAGE_DIR"
    fi
    if [[ ! -r $IMAGE_DIR ]]; then
        die "$EXIT_CONFIG_ERROR" "Image directory not readable: $IMAGE_DIR"
    fi
    if [[ ${#NODE_SPECS[@]} -eq 0 ]]; then
        die "$EXIT_CONFIG_ERROR" "No node specifications provided"
    fi

    log "Image directory: $IMAGE_DIR"
    log "Node specifications: ${#NODE_SPECS[@]}"
}

generate_mac() {
    local name="$1"
    local hash
    hash="$(echo -n "$name" | md5sum | tr '[:lower:]' '[:upper:]')"
    printf "%s:%s:%s:%s" "$MAC_PREFIX" "${hash:0:2}" "${hash:2:2}" "${hash:4:2}"
}

normalize_memory_for_systemd() {
    local mem="$1"
    if [[ $mem =~ ^[0-9]+$ ]]; then
        echo "${mem}M"
        return
    fi
    echo "$mem"
}

wait_for_unit_active() {
    local unit_name="$1"
    local timeout="${2:-10}"
    local interval=0.2
    local waited=0

    while [[ $waited -lt $((timeout * 5)) ]]; do
        if systemctl is-active --quiet "$unit_name" 2>/dev/null; then
            return 0
        fi
        sleep "$interval"
        ((++waited))
    done
    return 1
}

map_oci_to_qemu_arch() {
    local oci_arch="$1"
    case "$oci_arch" in
        amd64)
            echo "x86_64"
            ;;
        arm64)
            echo "aarch64"
            ;;
        x86_64 | aarch64)
            echo "$oci_arch"
            ;;
        *)
            die "$EXIT_CONFIG_ERROR" "Unknown architecture: $oci_arch (supported: amd64, arm64, x86_64, aarch64)"
            ;;
    esac
}

resolve_node_image() {
    local node_name="$1"
    local custom_image="$2"
    local arch="$3"

    if [[ -n $custom_image ]]; then
        if [[ $custom_image != *.qcow2 ]]; then
            die "$EXIT_CONFIG_ERROR" "Custom image must be a .qcow2 file: $custom_image (for node: $node_name)"
        fi
        local -r image_file="${IMAGE_DIR}/${custom_image}"
        if [[ ! -f $image_file ]]; then
            die "$EXIT_CONFIG_ERROR" "Custom image not found: $image_file (for node: $node_name)"
        fi
        log "    Image: $custom_image (custom)"
        echo "$image_file"
        return
    fi

    local arch_suffix legacy_arch
    case "$arch" in
        x86_64)
            arch_suffix="amd64"
            legacy_arch="qemux86-64"
            ;;
        aarch64)
            arch_suffix="arm64"
            legacy_arch="qemuarm64"
            ;;
        *) die "$EXIT_RUNTIME_ERROR" "Unknown architecture $arch!" ;;
    esac

    # Final regex: e.g., ^aos-vm-main-(amd64|qemux86-64)*\.qcow2$
    local img_regex="^${IMAGE_PREFIX}${node_name}-(${arch_suffix}|${legacy_arch}).*\.${DISK_FORMAT}$"

    local found_img="" file basename_file
    for file in "$IMAGE_DIR"/*; do
        [[ -e $file ]] || continue
        basename_file="${file##*/}"
        if [[ $basename_file =~ $img_regex ]]; then
            found_img="$basename_file"
            break
        fi
    done

    if [[ -z $found_img ]]; then
        die "$EXIT_CONFIG_ERROR" "Image not found for node: $node_name" "regex searched: $img_regex"
    fi

    log "  Image: $found_img (auto-discovered)"
    echo "${IMAGE_DIR}/${found_img}"
}

validate_static_ip() {
    local node_name="$1"
    local custom_ip="$2"
    # Associative array passed by name for duplicate tracking
    local -n _allocated="$3"

    local ip_int mask_int bridge_int net_int bcast_int
    ip_int=$(ip_to_int "$custom_ip")
    mask_int=$(((0xFFFFFFFF << (32 - NETMASK)) & 0xFFFFFFFF))
    bridge_int=$(ip_to_int "$BRIDGE_IP")
    net_int=$(net_int_from_ip_mask "$bridge_int" "$mask_int")
    bcast_int=$(bcast_int_from_net_mask "$net_int" "$mask_int")
    bridge_int=$((net_int + 1))

    if (((ip_int & mask_int) != net_int)); then
        die "$EXIT_CONFIG_ERROR" "Custom IP $custom_ip for node '$node_name' is outside the subnet"
    fi
    if ((ip_int == net_int)); then
        die "$EXIT_CONFIG_ERROR" "Custom IP $custom_ip for node '$node_name' conflicts with network address"
    fi
    if ((ip_int == bcast_int)); then
        die "$EXIT_CONFIG_ERROR" "Custom IP $custom_ip for node '$node_name' conflicts with broadcast address"
    fi
    if ((ip_int == bridge_int)); then
        die "$EXIT_CONFIG_ERROR" "Custom IP $custom_ip for node '$node_name' conflicts with AosEdge bridge ($BRIDGE_IP)"
    fi
    if [[ -n ${_allocated["$custom_ip"]:-} ]]; then
        die "$EXIT_CONFIG_ERROR" "Duplicate static IP $custom_ip detected (assigned to multiple nodes)"
    fi
    _allocated["$custom_ip"]=1
}

prepare_nodes() {
    declare -A allocated_ips

    log "Preparing nodes from configuration..."

    local node_spec
    for node_spec in "${NODE_SPECS[@]}"; do
        local name custom_image custom_ip custom_arch custom_machine_type custom_cpu_type cpu mem uefi_en
        IFS='|' read -r name custom_image custom_ip custom_arch \
            custom_machine_type custom_cpu_type cpu mem uefi_en <<<"$node_spec"

        log "Processing node: $name"

        local arch
        if [[ -n $custom_arch ]]; then
            arch="$(map_oci_to_qemu_arch "$custom_arch")"
            log "    Architecture: $arch (explicit)"
        else
            arch="$HOST_ARCH"
            log "    Architecture: $arch (host default)"
        fi

        local image_file
        image_file="$(resolve_node_image "$name" "$custom_image" "$arch")"

        local ip=""
        if [[ -n $custom_ip ]]; then
            validate_static_ip "$name" "$custom_ip" allocated_ips
            ip="$custom_ip"
            log "    IP: $ip (static via DHCP reservation)"
        else
            log "    IP: (dynamic via DHCP)"
        fi

        local machine_type
        if [[ -n $custom_machine_type ]]; then
            machine_type="$custom_machine_type"
            log "    Machine type: $machine_type (custom)"
        else
            case "$arch" in
                x86_64) machine_type="$DEFAULT_MACHINE_TYPE_AMD64" ;;
                aarch64) machine_type="$DEFAULT_MACHINE_TYPE_ARM64" ;;
            esac
            log "    Machine type: $machine_type (default)"
        fi

        local cpu_type
        if [[ -n $custom_cpu_type ]]; then
            cpu_type="$custom_cpu_type"
            log "    CPU type: $cpu_type (custom)"
        else
            case "$arch" in
                x86_64) cpu_type="$DEFAULT_CPU_TYPE_AMD64" ;;
                aarch64) cpu_type="$DEFAULT_CPU_TYPE_ARM64" ;;
            esac
            log "    CPU type: $cpu_type (default)"
        fi

        local use_kvm
        if [[ ${ENABLE_KVM:-true} == "false" ]]; then
            use_kvm="false"
            log "    KVM: is not enabled (ENABLE_KVM is undefined or set to 'false')"
        elif check_kvm_available "$arch"; then
            use_kvm="true"
            log "    KVM: enabled (native architecture)"
        else
            use_kvm="false"
            if [[ $arch != "$HOST_ARCH" ]]; then
                log "    KVM: disabled (cross-arch: host=$HOST_ARCH, vm=$arch)"
            else
                log "    KVM: disabled (/dev/kvm not available)"
            fi
        fi

        local uefi_boot="false"
        if [[ -n $uefi_en && $uefi_en != "null" ]]; then
            uefi_boot="${uefi_en,,}" # Force lowercase for safety
            log "  Boot mode: UEFI=${uefi_boot} (explicit config)"
        elif [[ ${image_file,,} == *uefi* ]]; then
            uefi_boot="true"
            log "  Boot mode: UEFI=true (auto-detected from filename)"
        else
            log "  Boot mode: UEFI=false (default)"
        fi

        local mac
        mac="$(generate_mac "$name")"
        log "    MAC: $mac"
        log "    CPU: $cpu, Memory: $mem"

        NODES_TO_START+=("${name}|${image_file}|${arch}|${mac}|${ip}|${cpu}|${mem}|${machine_type}|${cpu_type}|${use_kvm}|${uefi_boot}")
    done

    if [[ ${#NODES_TO_START[@]} -eq 0 ]]; then
        die "$EXIT_CONFIG_ERROR" "No valid nodes prepared"
    fi
    log "Prepared ${#NODES_TO_START[@]} node(s) for startup"
}

rotate_debug_log() {
    local node_name="$1"
    local debug_log_path="$2"

    log "  Forcing log rotation for previous debug session..."

    local lr_conf="${RUNTIME_DIRECTORY}/${node_name}-logrotate.conf"
    local lr_status="${RUNTIME_DIRECTORY}/${node_name}-logrotate.status"

    cat >"$lr_conf" <<EOF
"${debug_log_path}" {
    rotate 5
    missingok
    notifempty
    copytruncate
    compress
    delaycompress
}
EOF
    logrotate -s "$lr_status" -f "$lr_conf"
    rm -f "$lr_conf" "$lr_status"
}

build_uefi_pflash_args() {
    local arch="$1"
    local node_name="$2"
    # Output array passed by name (nameref)
    local -n _cmd="$3"

    local ovmf_code ovmf_vars
    case "$arch" in
        x86_64)
            ovmf_code="$OVMF_CODE_X86"
            ovmf_vars="$OVMF_VARS_X86"
            ;;
        aarch64)
            ovmf_code="$OVMF_CODE_ARM"
            ovmf_vars="$OVMF_VARS_ARM"
            ;;
    esac

    if [[ ! -f $ovmf_code || ! -f $ovmf_vars ]]; then
        die "$EXIT_RUNTIME_ERROR" "UEFI requested but firmware missing for $arch at $ovmf_code"
    fi

    local ovmf_vars_vm="${RUNTIME_DIRECTORY}/${node_name}-VARS.fd"
    if [[ ! -f $ovmf_vars_vm ]]; then
        cp "$ovmf_vars" "$ovmf_vars_vm"
        log "    Created UEFI vars: $(basename "$ovmf_vars_vm")"
    fi

    # Mount the read-only CODE and read-write VARS as pflash drives
    _cmd+=(
        -drive "if=pflash,format=raw,readonly=on,file=${ovmf_code}"
        -drive "if=pflash,format=raw,file=${ovmf_vars_vm}"
    )
}

start_qemu_vm() {
    local node_name="$1"
    local image_path="$2"
    local arch="$3"
    local mac_addr="$4"
    local ip="$5"
    local cpu_count="$6"
    local memory="$7"
    local machine_type="$8"
    local cpu_type="$9"
    local use_kvm="${10}"
    local uefi_boot="${11}"

    log "Starting VM: $node_name"
    log "    Image: $(basename "$image_path")"
    log "    Architecture: $arch"
    log "    KVM: $use_kvm"
    log "    Machine: $machine_type, CPU: $cpu_type"
    log "    Resources: ${cpu_count} vCPU, ${memory} RAM"

    if [[ -n $ip ]]; then
        log "    Network: MAC=$mac_addr, IP=$ip (static)"
    else
        log "    Network: MAC=$mac_addr, IP=(dynamic)"
    fi

    local -r unit_name="aos-unit-node-${node_name}"
    local -r qmp_socket="${RUNTIME_DIRECTORY}/${node_name}.qmp"
    local -r socket_path="${RUNTIME_DIRECTORY}/${node_name}.serial"
    local -r serial_log_path="${LOGS_DIRECTORY}/${node_name}-serial.log"
    local -r debug_log_path="${LOGS_DIRECTORY}/${node_name}-debug.log"

    local qemu_cmd=(
        "qemu-system-${arch}"
        -name "$node_name"
        -drive "file=${image_path},if=none,id=aos-image,format=${DISK_FORMAT}"
        -device "virtio-scsi-pci,id=scsi"
        -device "scsi-hd,drive=aos-image"
        -machine "$machine_type"
    )

    if [[ $use_kvm == "true" ]]; then
        qemu_cmd+=(-enable-kvm)
        # KVM implementation for Arm practically demands -cpu host to function properly
        if [[ $arch == "aarch64" ]]; then
            qemu_cmd+=(-cpu host)
        else
            qemu_cmd+=(-cpu "$cpu_type")
        fi
    else
        qemu_cmd+=(-cpu "$cpu_type")
    fi

    if [[ $uefi_boot == "true" ]]; then
        build_uefi_pflash_args "$arch" "$node_name" qemu_cmd
    fi

    # Generate TAP interface name from MAC address
    local mac_nocolon="${mac_addr//:/}"
    local tap="aostap${mac_nocolon: -6}"
    if ((${#tap} > 15)); then
        die "$EXIT_RUNTIME_ERROR" "Generated tap name too long: $tap"
    fi

    # usage:
    #   sudo socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:${socket_path}"
    qemu_cmd+=(
        -smp "cpus=${cpu_count}"
        -m "$memory"
        -netdev "tap,id=net0,ifname=${tap},script=no,downscript=no"
        -device "virtio-net-pci,netdev=net0,mac=${mac_addr}"
        -display none
        -vga none
        -chardev "socket,id=char0,path=${socket_path},server=on,wait=off,logfile=${serial_log_path},logappend=on"
        -serial "chardev:char0"
        -d "$QEMU_DEBUG_OPTIONS"
        -D "${debug_log_path}"
        -qmp "unix:${qmp_socket},server,nowait"
    )

    # On every startup QEMU will overwrite its own logs.
    # To avoid losing them, enforce debug log rotation beforehand.
    if [[ -f $debug_log_path ]]; then
        rotate_debug_log "$node_name" "$debug_log_path"
    fi

    log "    Launching via systemd (unit: $unit_name)"
    wait_for_transient_cleanup "$unit_name"

    local systemd_mem
    systemd_mem="$(normalize_memory_for_systemd "$memory")"

    local exec_start_pre="${LIBEXEC_DIR}/network-helper add-vm ${mac_addr} ${node_name} ${tap}"
    if [[ -n $ip ]]; then
        exec_start_pre="${exec_start_pre} ${ip}"
    fi

    local exec_stop_post="${LIBEXEC_DIR}/network-helper del-vm ${mac_addr} ${node_name} ${tap}"
    if [[ -n $ip ]]; then
        exec_stop_post="${exec_stop_post} ${ip}"
    fi

    local -r exec_stop="${LIBEXEC_DIR}/vm-shutdown ${node_name}"

    systemd-run \
        --unit="$unit_name" \
        --description="AosEdge Unit VM: ${node_name} (${arch})" \
        --property="EnvironmentFile=${RUNTIME_DIRECTORY}/${NETWORK_CONFIG}" \
        --setenv="RUNTIME_DIRECTORY=${RUNTIME_DIRECTORY}" \
        --setenv="NETWORK_CONFIG=${NETWORK_CONFIG}" \
        --setenv="DHCP_HOSTS_DIR=${DHCP_HOSTS_DIR}" \
        --setenv="DNS_HOSTS_DIR=${DNS_HOSTS_DIR}" \
        --slice=aos-unit.slice \
        --property="Type=simple" \
        --property="After=aos-unit.service" \
        --property="BindsTo=aos-unit.service" \
        --property="User=aos-unit" \
        --property="Group=aos-unit" \
        --property="AmbientCapabilities=CAP_NET_ADMIN" \
        --property="CapabilityBoundingSet=CAP_NET_ADMIN" \
        --property="RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6" \
        --property="Restart=on-failure" \
        --property="RestartSec=${HEALTH_RESTART_SEC:-5s}" \
        --property="KillMode=control-group" \
        --property="KillSignal=SIGTERM" \
        --property="TimeoutStopSec=${VM_STOP_TIMEOUT:-60s}" \
        --property="SendSIGKILL=yes" \
        --property="NoNewPrivileges=yes" \
        --property="PrivateTmp=yes" \
        --property="ProtectHome=yes" \
        --property="ProtectSystem=strict" \
        --property="ProtectKernelTunables=yes" \
        --property="ProtectKernelModules=yes" \
        --property="ProtectControlGroups=yes" \
        --property="ProtectKernelLogs=yes" \
        --property="LockPersonality=yes" \
        --property="RestrictNamespaces=yes" \
        --property="RestrictRealtime=yes" \
        --property="SystemCallArchitectures=native" \
        --property="ReadWritePaths=${RUNTIME_DIRECTORY}" \
        --property="ReadWritePaths=${LOGS_DIRECTORY}" \
        --property="ReadWritePaths=${STATE_DIRECTORY}" \
        --property="RestrictSUIDSGID=yes" \
        --property="DevicePolicy=closed" \
        --property="DeviceAllow=/dev/kvm rw" \
        --property="DeviceAllow=/dev/vhost-net rw" \
        --property="DeviceAllow=/dev/net/tun rw" \
        --property="StartLimitIntervalSec=${HEALTH_RESTART_WINDOW:-300}" \
        --property="StartLimitBurst=${HEALTH_MAX_RESTARTS:-3}" \
        --property="TimeoutStartSec=${VM_START_TIMEOUT:-60s}" \
        --property="ExecStartPre=${exec_start_pre}" \
        --property="ExecStop=${exec_stop}" \
        --property="ExecStopPost=${exec_stop_post}" \
        --property="OnFailure=aos-unit-vm-failed@${unit_name}.service" \
        --property="MemoryMax=${systemd_mem}" \
        --property="OOMPolicy=kill" \
        --property="CPUQuota=$((cpu_count * 100))%" \
        --collect \
        --quiet -- \
        "${qemu_cmd[@]}"

    if ! wait_for_unit_active "$unit_name" 10; then
        die "${EXIT_RUNTIME_ERROR}" "Timeout waiting for unit to start: $node_name (check: systemctl status $unit_name)"
    fi

    local pid
    pid="$(systemctl show -p MainPID --value "$unit_name" 2>/dev/null || true)"
    if [[ -z $pid || $pid == "0" ]]; then
        die "${EXIT_RUNTIME_ERROR}" "Unit started but MainPID not found: $node_name"
    fi

    log "    Started successfully (PID: $pid)"
    log "    Access via: ssh ${node_name}.aos-unit"
}

launch_all_vms() {
    log "Starting QEMU VMs..."

    local node
    for node in "${NODES_TO_START[@]}"; do
        local name image arch mac ip cpu mem machine cpu_type use_kvm uefi_boot
        IFS='|' read -r name image arch mac ip cpu mem machine cpu_type use_kvm uefi_boot <<<"$node"
        start_qemu_vm "$name" "$image" "$arch" "$mac" "$ip" "$cpu" "$mem" "$machine" "$cpu_type" "$use_kvm" "$uefi_boot"
    done

    log "All VMs started successfully"
    log "Runner active - VMs managed by systemd"
}

cleanup_route_monitor() {
    if [[ -n ${IPMON_PID} ]]; then
        log "Shutting down route monitor..."
        kill "${IPMON_PID}" 2>/dev/null || true
        wait "${IPMON_PID}" 2>/dev/null || true
    fi
}

route_monitor_loop() {
    local pending=0
    local line

    while true; do
        if ((pending == 1)); then
            # Debounce: wait for quiet time after default route event
            if IFS= read -r -t "${DEBOUNCE_SEC}" -u "${ipmon[0]}" line; then
                # Another route event during quiet window; reset timer
                :
            else
                if kill -0 "${IPMON_PID}" 2>/dev/null; then
                    # read timed out — changes have settled
                    log "Route changes settled. Applying NAT rules..."
                    "${LIBEXEC_DIR}/network-helper" add-nat || true
                    pending=0
                else
                    # kill -0 failed — ip monitor died
                    die "${EXIT_RUNTIME_ERROR}" "Error: ip monitor stream ended unexpectedly."
                fi
            fi
        else
            # Wait for default route event (blocking read)
            if IFS= read -r -u "${ipmon[0]}" line; then
                [[ ${line} == *"default"* ]] && pending=1
            else
                # Blocking read failed: could be EINTR signal OR EOF
                if kill -0 "${IPMON_PID}" 2>/dev/null; then
                    # Coprocess is alive -> read was likely interrupted by a signal, keep looping
                    continue
                else
                    # Coprocess is dead -> EOF
                    die "${EXIT_RUNTIME_ERROR}" "Error: ip monitor stream ended unexpectedly."
                fi
            fi
        fi
    done
}

start_route_monitoring() {
    log "Starting route monitoring..."

    # Start ip monitor as a coprocess (exec to avoid subshell)
    coproc ipmon { exec /usr/sbin/ip monitor route; }
    # shellcheck disable=SC2154
    IPMON_PID="${ipmon_PID}"

    # Verify coprocess started
    if ! kill -0 "${IPMON_PID}" 2>/dev/null; then
        die "${EXIT_RUNTIME_ERROR}" "Failed to start ip monitor coprocess"
    fi

    log "Route monitor started (PID: ${IPMON_PID})"

    # Set up cleanup handler for route monitor
    trap cleanup_route_monitor EXIT
    trap 'exit 0' INT TERM

    route_monitor_loop
}

main() {
    HOST_ARCH="$(detect_host_arch)"
    readonly HOST_ARCH
    log "Host architecture: $HOST_ARCH"

    parse_args "$@"
    parse_config_file "$CONFIG_FILE" "$IMAGE_DIR"
    validate_config
    prepare_nodes

    trap 'exit 0' SIGTERM SIGINT

    log "AosEdge Unit Runner starting (PID: $$)"

    launch_all_vms

    if [[ -z ${INTERNET_INTERFACE:-} ]]; then
        start_route_monitoring
    else
        sleep infinity
    fi
}

main "$@"
