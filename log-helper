#!/usr/bin/env bash

readonly EXIT_RUNTIME_ERROR=1
readonly EXIT_CONFIG_ERROR=2

: "${LOG_TAG:=aos-unit}"

# Informational message (stdout)
log() {
    printf '%s: %s\n' "$LOG_TAG" "$*" >&2
}

# Error message (stderr)
error() {
    printf '%s: ERROR: %s\n' "$LOG_TAG" "$*" >&2
}

# Multi-line error message (each line prefixed)
error_multi() {
    while IFS= read -r line; do
        printf '%s: ERROR: %s\n' "$LOG_TAG" "$line" >&2
    done
}

# Log error and exit.
# Usage:
#   die "message"
#   die EXIT_CONFIG_ERROR "message"
die() {
    local code=1
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then
        code="$1"
        shift
    fi
    error "$*"
    exit "$code"
}

# Block until a transient systemd unit is unloaded (LoadState=not-found).
# systemd-run --collect forgets the unit name asynchronously; creating the
# same name again before that finishes fails with "already loaded".
wait_for_transient_cleanup() {
    local unit_name="${1%.service}"
    local -r interval=0.2
    local load_state

    load_state="$(systemctl show -p LoadState --value "${unit_name}.service" 2>/dev/null || true)"
    if [[ $load_state == "not-found" || -z $load_state ]]; then
        return 0
    fi

    trap 'die "${EXIT_RUNTIME_ERROR}" "CRITICAL ERROR: Systemd timeout reached! ${unit_name} failed to clean up."' SIGTERM

    systemctl reset-failed "${unit_name}.service" 2>/dev/null || true
    systemctl stop "${unit_name}.service" >/dev/null 2>&1 || true

    log "Waiting for transient unit to unload: ${unit_name}"
    while [[ "$(systemctl show -p LoadState --value "${unit_name}.service" 2>/dev/null)" != "not-found" ]]; do
        sleep "${interval}"
    done

    trap - SIGTERM
}

ip_to_int() {
    local IFS=.
    local -a ipp
    IFS=. read -r -a ipp <<<"$1"
    echo $(((10#${ipp[0]} << 24) + (10#${ipp[1]} << 16) + (10#${ipp[2]} << 8) + 10#${ipp[3]}))
}

int_to_ip() {
    local i="$1"
    echo "$(((i >> 24) & 255)).$(((i >> 16) & 255)).$(((i >> 8) & 255)).$((i & 255))"
}

net_int_from_ip_mask() {
    echo $(($1 & $2))
}

bcast_int_from_net_mask() {
    echo $(($1 | ((~$2) & 0xFFFFFFFF)))
}
