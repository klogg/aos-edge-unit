#!/usr/bin/env bash

readonly EXIT_RUNTIME_ERROR=1
readonly EXIT_CONFIG_ERROR=2

: "${LOG_TAG:=aos-unit}"

# Informational message (stdout)
log() {
    printf '%s: %s\n' "$LOG_TAG" "$*" >&2
}

# Error message (stderr)
error() {
    printf '%s: ERROR: %s\n' "$LOG_TAG" "$*" >&2
}

# Multi-line error message (each line prefixed)
error_multi() {
    while IFS= read -r line; do
        printf '%s: ERROR: %s\n' "$LOG_TAG" "$line" >&2
    done
}

# Log error and exit.
# Usage:
#   die "message"
#   die EXIT_CONFIG_ERROR "message"
die() {
    local code=1
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then
        code="$1"
        shift
    fi
    error "$*"
    exit "$code"
}

# Block until a systemd unit is no longer running. Unlike transient units, a
# unit shipped as a file keeps its name after stopping, so LoadState never
# leaves "loaded" and ActiveState is the only usable signal.
wait_for_unit_stopped() {
    local -r unit_name="$1"
    local -r interval=0.2
    local state

    state="$(systemctl show -p ActiveState --value "$unit_name" 2>/dev/null || true)"
    if [[ -z $state || $state == "inactive" || $state == "failed" ]]; then
        return 0
    fi

    trap 'die "${EXIT_RUNTIME_ERROR}" "CRITICAL ERROR: Systemd timeout reached! ${unit_name} failed to stop."' SIGTERM

    systemctl stop "$unit_name" >/dev/null 2>&1 || true

    log "Waiting for unit to stop: ${unit_name}"
    while true; do
        state="$(systemctl show -p ActiveState --value "$unit_name" 2>/dev/null)"
        if [[ $state == "inactive" || $state == "failed" ]]; then
            break
        fi
        sleep "${interval}"
    done

    trap - SIGTERM
}

ip_to_int() {
    local IFS=.
    local -a ipp
    IFS=. read -r -a ipp <<<"$1"
    echo $(((10#${ipp[0]} << 24) + (10#${ipp[1]} << 16) + (10#${ipp[2]} << 8) + 10#${ipp[3]}))
}

int_to_ip() {
    local i="$1"
    echo "$(((i >> 24) & 255)).$(((i >> 16) & 255)).$(((i >> 8) & 255)).$((i & 255))"
}

net_int_from_ip_mask() {
    echo $(($1 & $2))
}

bcast_int_from_net_mask() {
    echo $(($1 | ((~$2) & 0xFFFFFFFF)))
}
