set -Eeuo pipefail

LIBEXEC_DIR="$(dirname "$(realpath "$0")")"
readonly LIBEXEC_DIR
readonly LOG_TAG="aos-unit:vm-failed"
. "${LIBEXEC_DIR}/log-helper"

: "${LOGS_DIRECTORY:?Environment variable LOGS_DIRECTORY is undefined}"

# Same path as aos-unit-node@.service ExecCondition. Missing means the manager
# is tearing down (or has not started nodes yet). Do not call systemctl
# is-active here: that can block on PID 1 during the same stop job.
readonly NODE_START_GATE="/run/aos-unit/allow-node-start"

is_planned_stop_failure() {
    [[ ! -e $NODE_START_GATE ]]
}

log_vm_failure() {
    local unit="$1"

    log "VM unit FAILED: ${unit}"
    log "Writing failure marker to: ${LOGS_DIRECTORY}/vm-failures.log"

    log "systemctl status:"
    systemctl --no-pager -l status "${unit}" 2>&1 | error_multi || true

    log "Last 200 journal lines:"
    journalctl --no-pager -u "${unit}" -n 200 2>&1 | error_multi || true

    local ts
    ts="$(date -Is 2>/dev/null || date)"
    echo "${ts} ${unit} failed" >>"${LOGS_DIRECTORY}/vm-failures.log"
}

main() {
    local -r unit="${1:?unit required}"
    if is_planned_stop_failure; then
        log "Ignoring ${unit} (node start gate is closed)"
        return 0
    fi
    log_vm_failure "$unit"
}

main "$@"
